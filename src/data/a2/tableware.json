  "sentences": [
    {
      "de": "Kannst du bitte das Besteck auf den Tisch legen?",
      "en": "Can you put the cutlery on the table, please?",
      "es": "¿Puedes poner los cubiertos en la mesa, por favor?"
    },
    {
      "de": "Die Suppe ist mir zu scharf.",
      "en": "The soup is too spicy for me.",
      "es": "La sopa está demasiado picante para mí."
    },
    {
      "de": "Nach dem Essen spülen wir das Geschirr.",
      "en": "After the meal we wash the dishes.",
      "es": "Después de comer fregamos los platos."
    },
    {
      "de": "Der Kuchen schmeckt nach Zimt.",
      "en": "The cake tastes of cinnamon.",
      "es": "El pastel sabe a canela."
    },
    {
      "de": "Stell die Tasse bitte auf die Untertasse!",
      "en": "Please put the cup on the saucer!",
      "es": "¡Pon la taza en el platillo, por favor!"
    },
    {
      "de": "Zitronen schmecken sauer und Schokolade schmeckt süß.",
      "en": "Lemons taste sour and chocolate tastes sweet.",
      "es": "Los limones saben ácidos y el chocolate sabe dulce."
    },
    {
      "de": "Neben jedem Teller liegt eine Serviette.",
      "en": "There is a napkin next to every plate.",
      "es": "Al lado de cada plato hay una servilleta."
