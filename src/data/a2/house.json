  "sentences": [
    {
      "de": "Kann ich dir beim Rasenmähen helfen?",
      "en": "Can I help you mow the lawn?",
      "es": "¿Te puedo ayudar a cortar el césped?"
    },
    {
      "de": "Der Rasenmäher steht im Gartenhaus.",
      "en": "The lawnmower is in the garden shed.",
      "es": "El cortacésped está en la caseta de jardín."
    },
    {
      "de": "Die Gießkanne liegt hinter der Garage.",
      "en": "The watering can is behind the garage.",
      "es": "La regadera está detrás del garaje."
    },
    {
      "de": "Der Hausmeister putzt jeden Montag das Treppenhaus.",
      "en": "The caretaker cleans the stairwell every Monday.",
      "es": "El conserje limpia la escalera todos los lunes."
    },
    {
      "de": "Wir müssen die Hecke am Zaun schneiden.",
      "en": "We have to cut the hedge by the fence.",
      "es": "Tenemos que podar el seto junto a la valla."
    },
    {
      "de": "Danke, das ist sehr nett, aber ich schaffe das allein.",
      "en": "Thanks, that's very kind, but I can manage on my own.",
      "es": "Gracias, es muy amable, pero puedo hacerlo solo."
    }
  ]
