  "sentences": [
    {
      "de": "Als Kind hatte ich einen großen Teddybären.",
      "en": "As a child I had a big teddy bear.",
      "es": "De niño tenía un osito de peluche grande."
    },
    {
      "de": "Wir haben jeden Nachmittag auf dem Spielplatz gespielt.",
      "en": "We played at the playground every afternoon.",
      "es": "Jugábamos en el parque infantil todas las tardes."
    },
    {
      "de": "Meine Oma hat mir oft Märchen erzählt.",
      "en": "My grandma often told me fairy tales.",
      "es": "Mi abuela me contaba cuentos de hadas a menudo."
    },
    {
      "de": "Im Herbst haben wir Drachen steigen lassen.",
      "en": "In autumn we flew kites.",
      "es": "En otoño volábamos cometas."
    },
    {
      "de": "Ich habe schöne Erinnerungen an meine Kindheit.",
      "en": "I have nice memories of my childhood.",
      "es": "Tengo bonitos recuerdos de mi infancia."
    },
    {
      "de": "Wie viel Taschengeld hast du bekommen?",
      "en": "How much pocket money did you get?",
      "es": "¿Cuánta paga recibías?"
    }
  ]
